# Ne jamais committer de clés réelles. Copiez vers .env.local pour le développement.

# Google Analytics 4 (identifiant de mesure — chargé uniquement après consentement analytique)
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XECS76B3RJ

# Microsoft Clarity (production uniquement — chargé uniquement après consentement analytique)
NEXT_PUBLIC_CLARITY_PROJECT_ID=xs8k921z4a

# Google AdSense
NEXT_PUBLIC_ADSENSE_ID=
NEXT_PUBLIC_AD_SLOT_UNDER_H1=
NEXT_PUBLIC_AD_SLOT_AFTER_RESULT=
NEXT_PUBLIC_AD_SLOT_BEFORE_FOOTER=

# IndexNow (serveur / CI uniquement — jamais de préfixe NEXT_PUBLIC_)
# Contenu de public/indexnow.txt (et public/<clé>.txt) — doit être identique
# au secret GitHub INDEXNOW_KEY et à la variable Vercel INDEXNOW_KEY.
INDEXNOW_KEY=
# Origine canonique (requis pour npm run indexnow:notify)
# SITE_URL=https://calculer-mon-imc.fr

# Resend (serveur uniquement — jamais de préfixe NEXT_PUBLIC_)
RESEND_API_KEY=
# Destinataire des messages (défaut : contact@calculer-mon-imc.fr)
CONTACT_EMAIL=contact@calculer-mon-imc.fr
# Expéditeur (domaine vérifié dans Resend)
CONTACT_FROM_EMAIL=Calculer Mon IMC <contact@calculer-mon-imc.fr>

# Limitation des envois (optionnel — voir src/site/contact/contact-rate-limit.ts)
# En production sans Redis Upstash, aucune limite n'est appliquée.
# CONTACT_RATE_LIMIT_MAX=5
# CONTACT_RATE_LIMIT_WINDOW_SEC=3600
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
